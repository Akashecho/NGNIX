# =============================================================================
#  TARS - LOCAL EDITION
#  Everything runs on this machine. No API key, no network call, no cloud bill.
#
#  Copy this file over the engine's .env to switch editions:
#      Copy-Item local\.env.local ngnix-astra-brain-engine\.env
#  Or let the launcher do it:  .\local\run-local.ps1
#
#  The cloud edition's profile lives in local\.env.azure.backup once you have
#  run the launcher at least once.
# =============================================================================

BRAIN_SESSION_TOKEN=tars-local-dev-only-2f8b91c47ae35d06
BRAIN_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# --- Brain: local model through Ollama -------------------------------------
LLM_PROVIDER=ollama
OLLAMA_ENDPOINT=http://127.0.0.1:11434
# Beta tier for a 16 GB CPU-only laptop. See local/README.md for the tier table:
# raise this to qwen2.5:7b-instruct-q4_K_M on the 24 GB / 8 GB VRAM machine.
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
# Reasoning traces off: a small model would spend its whole budget thinking.
OLLAMA_THINK=false

# --- Ears: Whisper on this machine ----------------------------------------
STT_PROVIDER=local
# tiny | base | small | medium | large-v3 | large-v3-turbo
# 'small' is the honest floor for Indian languages; 'base' and below mangle them.
WHISPER_MODEL=small
# cpu | cuda. int8 on CPU, float16 on a real GPU.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 0 lets CTranslate2 choose. Set it to leave cores for the LLM if they compete.
WHISPER_CPU_THREADS=0
# Greedy decoding. Beam search costs 2-3x the time for little gain on short turns.
WHISPER_BEAM_SIZE=1
ASR_LANGUAGE=auto

# --- Voice: Piper where a voice exists, espeak-ng everywhere else ----------
TTS_PROVIDER=local
# auto | piper | espeak
TTS_LOCAL_ENGINE=auto
PIPER_MODEL_DIR=models/piper
ESPEAK_BINARY=espeak-ng

# --- No cloud keys. Left empty deliberately; do not fill these in. ---------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
DEEPGRAM_API_KEY=
SEARCH_API_KEY=

# --- Retrieval -------------------------------------------------------------
# A separate index from the Azure edition: the two embedding spaces are not
# interchangeable, and keeping both files means switching editions does not
# force a re-ingest.
RAG_CORPUS_PATH=corpus.local.json
RAG_REQUIRED=true
# Measured on a CPU-only laptop: prompt evaluation costs about one second per 60
# tokens, so retrieved context is the second largest latency item after the
# persona. Two 500-character passages cost ~250 prompt tokens instead of the
# ~700 that four 700-character ones cost, which is ~8 seconds a turn here.
RAG_TOP_K=2
RAG_BLOCK_CHARS=500
RAG_CONFIDENCE_FLOOR=0.25
RAG_CITATION_MODE=lenient
RAG_ALLOW_ANY_SOURCE=true

# The compact persona: same character, roughly a quarter of the tokens. See the
# measurements above compact_character_block in brain/persona.py.
PROMPT_STYLE=compact

ASSISTANT_MODE=open
LLM_TEMPERATURE=0.4

# Every tool this project has needs the network: web_search hits DuckDuckGo or
# Brave, fetch_page reads a URL, get_weather calls an API. None can work with the
# network unplugged, so they are off rather than failing mid-turn. Turn this on
# only if the machine actually has internet and you accept that those three tools
# make outbound calls.
TOOLS_ENABLED=false
# A local turn is slower than a cloud turn: STT, then the LLM, then TTS, all on
# the same CPU. This ceiling is generous on purpose.
BRAIN_TURN_TIMEOUT=180
# One conversation at a time on Pi-class hardware.
BRAIN_MAX_SESSIONS=2

# --- Persona: TARS, ported from the reference project ---------------------
# Reference TARS-AI persona.ini used humour 40 / sarcasm 50 / honesty 95 /
# verbosity 10 / formality 10 / confidence 100. Verbosity is lifted slightly
# because this edition answers cooperative questions, not just banter.
PERSONA_HUMOUR=40
PERSONA_SARCASM=50
PERSONA_HONESTY=95
PERSONA_WARMTH=45
PERSONA_VERBOSITY=15
PERSONA_FORMALITY=10
PERSONA_CONFIDENCE=100

# --- Robotic voice colouring ---------------------------------------------
# Piper and espeak-ng are drier than Azure's neural voices, so the ring
# modulation is eased off and clarity raised to keep consonants intelligible
# through a small speaker.
VOICE_CLARITY=0.7
VOICE_AUTOTUNE=0.30
ROBOT_AMOUNT=0.15
VOICE_RATE=1.0
VOICE_PITCH=0
